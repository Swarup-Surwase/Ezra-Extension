# ==============================================================================
# TrueForge Agent Harness Local Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your model provider API key(s).
# NEVER commit your .env file or real API keys to version control.
# ==============================================================================

# TrueForge server HTTP port (default: 8790)
PORT=8790

# Standalone mode: SQLite database (no Redis required for local execution)
STANDALONE=true

# Model Provider API Keys (configured in TrueForge harness, NOT in the extension)
# Configure at least one primary model provider:
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Secondary model provider for automatic fallback (Resilience Task C)
# FIREWORKS_API_KEY=your-fireworks-api-key-here

